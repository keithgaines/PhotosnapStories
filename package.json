{
  "private": true,
  "workspaces": {
    "packages": [
      "api",
      "web"
    ]
  },
  "devDependencies": {
    "@redwoodjs/core": "5.0.6"
  },
  "eslintConfig": {
    "extends": "@redwoodjs/eslint-config",
    "root": true
  },
  "engines": {
    "node": "20.x",
    "yarn": "3.x"
  },
  "packageManager": "yarn@3.5.0",
  "prisma": {
    "seed": "yarn rw exec seed"
  },
  "scripts": {
    "preinstall": "corepack enable",
    "vercel-build": "yarn install --immutable && yarn rw build"
  }
}
